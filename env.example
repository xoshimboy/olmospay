# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application.
APP_URL="MY_APP_URL"

# Telegram Bot & Mini App Configuration (Netlify Environment Variables)
TG_BOT_TOKEN="MY_REVOKED_AND_ROTATED_BOT_TOKEN"
TG_ADMIN_ID="MY_NUMERIC_TELEGRAM_ADMIN_ID"
TG_WEBHOOK_SECRET="MY_RANDOM_WEBHOOK_SECRET_HEX"

# Sora Reseller API Key (never expose to client or URL)
SORA_API_KEY="MY_SORA_API_KEY"

# HMAC secret for signing guest order status tokens
ORDER_TOKEN_SECRET="MY_RANDOM_ORDER_TOKEN_SECRET"

# Admin panel key for uploading service cover images via web browser
ADMIN_PANEL_KEY="MY_RANDOM_ADMIN_PANEL_KEY"

# Strict CORS origin for Netlify Functions (e.g. https://gamepin.uz)
ALLOWED_ORIGIN="https://gamepin.uz"

# Set "true" when hosting the site separately from standalone /bot to avoid Telegram 409 conflict
DISABLE_BOT_POLLING="true"
